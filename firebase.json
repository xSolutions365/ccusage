{
	"functions": [
		{
			"source": "firebase-deploy",
			"codebase": "ccusage-firebase",
			"ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"],
			"predeploy": [
				"pnpm --filter @ccusage/firebase build",
				"pnpm --filter @ccusage/firebase deploy:prep"
			]
		}
	],
	"hosting": {
		"public": "apps/web/public",
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
		"rewrites": [{ "source": "/api/download", "function": "download" }]
	},
	"firestore": {
		"rules": "firestore.rules"
	}
}
