{
	"name": "@ccusage/firebase",
	"type": "module",
	"version": "18.0.11",
	"private": true,
	"description": "Firebase Cloud Functions backend for storing ccusage statistics in Firestore",
	"license": "MIT",
	"engines": {
		"node": ">=20.19.4"
	},
	"scripts": {
		"build": "tsdown",
		"format": "pnpm run lint --fix",
		"lint": "eslint --cache .",
		"prerelease": "pnpm run lint && pnpm run typecheck && pnpm run build",
		"test": "TZ=UTC vitest",
		"typecheck": "tsgo --noEmit"
	},
	"devDependencies": {
		"@ccusage/internal": "workspace:*",
		"@ryoppippi/eslint-config": "catalog:lint",
		"@typescript/native-preview": "catalog:types",
		"eslint": "catalog:lint",
		"tsdown": "catalog:build",
		"valibot": "catalog:runtime",
		"vitest": "catalog:testing"
	}
}
